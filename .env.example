# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Create token: Cloudflare Dashboard → My Profile → API Tokens
# Minimum permissions: Account → Cloudflare Pages → Edit
#                     User → Memberships → Read
#
# Account ID: Dashboard → right sidebar → Copy Account ID
# (Paradise Spas / Increase ROAS account example below)

CLOUDFLARE_ACCOUNT_ID=a3f549867f040e13df33e5bd18f785f4
CLOUDFLARE_API_TOKEN=your_api_token_here
